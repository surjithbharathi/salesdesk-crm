@@ -0,0 +1,78 @@
+import { GlobalConfig } from '@n8n/config';
+import { UserRepository, type User } from '@n8n/db';
+import type { Response } from 'express';
+import { mock } from 'vitest-mock-extended';
+import { AuthService } from '@/auth/auth.service';
+import { MfaService } from '@/mfa/mfa.service';
+import type { AuthlessRequest } from '@/requests';
+import { PasswordUtility } from '@/services/password.utility';
+import { SalesdeskAccessService } from '@/services/salesdesk-access.service';
+import { SalesdeskController } from '../salesdesk.controller';
+
+describe('SalesdeskController', () => {
+	const config = mock<GlobalConfig>({
+		salesdesk: { enabled: true, crmOrigin: 'http://127.0.0.1:3100', bridgeSecret: 'x'.repeat(64) },
+	});
+	const access = mock<SalesdeskAccessService>();
+	const users = mock<UserRepository>();
+	const passwords = mock<PasswordUtility>();
+	const auth = mock<AuthService>();
+	const mfa = mock<MfaService>();
+	const controller = new SalesdeskController(config, access, users, passwords, auth, mfa);
+	const id = 'aaaaaaaa-aaaa-5aaa-8aaa-aaaaaaaaaaaa';
+	const req = mock<AuthlessRequest>({
+		body: { ticket: 'a'.repeat(43) },
+		browserId: 'browser',
+		headers: { 'x-salesdesk-engine-user': id },
+	});
+	const res = mock<Response>();
+	beforeEach(() => {
+		vi.resetAllMocks();
+		config.salesdesk.enabled = true;
+		access.consume.mockResolvedValue({ engineUserId: id, name: 'Employee', browserId: 'browser' });
+		users.findOne.mockResolvedValue(
+			mock<User>({
+				id,
+				email: `${id}@crm.internal.invalid`,
+				role: { slug: 'global:member' },
+				disabled: false,
+				mfaEnabled: false,
+			}),
+		);
+	});
+	it('issues the native member cookie after CRM authorization', async () => {
+		await expect(controller.login(req, res)).resolves.toEqual({ ready: true });
+		expect(access.assertAllowed).toHaveBeenCalledWith(id);
+		expect(auth.issueCookie).toHaveBeenCalledWith(
+			res,
+			expect.objectContaining({ id }),
+			false,
+			'browser',
+		);
+	});
+	it('does not issue cookies for a mismatched browser or gateway identity', async () => {
+		access.consume.mockResolvedValue({
+			engineUserId: id,
+			name: 'Employee',
+			browserId: 'different',
+		});
+		await expect(controller.login(req, res)).rejects.toThrow('not accepted');
+		access.consume.mockResolvedValue({
+			engineUserId: 'bbbbbbbb-bbbb-5bbb-8bbb-bbbbbbbbbbbb',
+			name: 'Employee',
+			browserId: 'browser',
+		});
+		await expect(controller.login(req, res)).rejects.toThrow('does not match');
+		expect(auth.issueCookie).not.toHaveBeenCalled();
+	});
+	it('keeps instance MFA and native role rules', async () => {
+		mfa.isMFAEnforced.mockResolvedValue(true);
+		await expect(controller.login(req, res)).rejects.toThrow('MFA');
+		mfa.isMFAEnforced.mockResolvedValue(false);
+		users.findOne.mockResolvedValue(
+			mock<User>({ id, email: `${id}@crm.internal.invalid`, role: { slug: 'global:owner' } }),
+		);
+		await expect(controller.login(req, res)).rejects.toThrow('not available');
+		expect(auth.issueCookie).not.toHaveBeenCalled();
+	});
+});
diff --git a/packages/cli/src/controllers/salesdesk.controller.ts b/packages/cli/src/controllers/salesdesk.controller.ts
new file mode 100644
index 00000000..e482c77f
--- /dev/null
+++ b/packages/cli/src/controllers/salesdesk.controller.ts
@@ -0,0 +1,90 @@
+// Modified for the internal Salesdesk integration. Upstream license terms apply.
+import { GlobalConfig } from '@n8n/config';
+import { UserRepository } from '@n8n/db';
+import { Post, RestController } from '@n8n/decorators';
+import { ForbiddenError, BadRequestError } from '@n8n/errors';
+import { isRecord } from '@n8n/utils/is-record';
+import type { Response } from 'express';
+import { randomBytes } from 'node:crypto';
+
+import { AuthService } from '@/auth/auth.service';
+import { MfaService } from '@/mfa/mfa.service';
+import type { AuthlessRequest } from '@/requests';
+import { PasswordUtility } from '@/services/password.utility';
+import { SalesdeskAccessService } from '@/services/salesdesk-access.service';
+
+@RestController('/salesdesk')
+export class SalesdeskController {
+	constructor(
+		private readonly config: GlobalConfig,
+		private readonly access: SalesdeskAccessService,
+		private readonly users: UserRepository,
+		private readonly passwords: PasswordUtility,
+		private readonly auth: AuthService,
+		private readonly mfa: MfaService,
+	) {}
+
+	@Post('/login', { skipAuth: true, ipRateLimit: { limit: 60 } })
+	async login(req: AuthlessRequest, res: Response) {
+		if (!this.config.salesdesk.enabled) throw new ForbiddenError('CRM integration is not enabled');
+		const input: unknown = req.body;
+		if (
+			!isRecord(input) ||
+			typeof input.ticket !== 'string' ||
+			!/^[A-Za-z0-9_-]{43}$/.test(input.ticket)
+		) {
+			throw new BadRequestError('A valid CRM handoff is required');
+		}
+		const identity = await this.access.consume(input.ticket);
+		if (
+			!isRecord(identity) ||
+			typeof identity.engineUserId !== 'string' ||
+			!/^[a-f0-9-]{36}$/.test(identity.engineUserId) ||
+			typeof identity.name !== 'string' ||
+			typeof identity.browserId !== 'string' ||
+			identity.browserId !== req.browserId
+		) {
+			throw new ForbiddenError('CRM handoff was not accepted');
+		}
+		if (req.headers['x-salesdesk-engine-user'] !== identity.engineUserId)
+			throw new ForbiddenError('CRM identity does not match');
+		await this.access.assertAllowed(identity.engineUserId);
+		if (await this.mfa.isMFAEnforced())
+			throw new ForbiddenError('Complete the instance MFA policy before using this integration');
+		const email = `${identity.engineUserId}@crm.internal.invalid`;
+		let user = await this.users.findOne({
+			where: { id: identity.engineUserId },
+			relations: ['role'],
+		});
+		if (!user) {
+			try {
+				({ user } = await this.users.createUserWithProject({
+					id: identity.engineUserId,
+					email,
+					firstName: identity.name.slice(0, 32) || 'Employee',
+					lastName: 'CRM',
+					password: await this.passwords.hash(randomBytes(48).toString('base64url')),
+					role: { slug: 'global:member' },
+					disabled: false,
+				}));
+			} catch {
+				user = await this.users.findOne({
+					where: { id: identity.engineUserId },
+					relations: ['role'],
+				});
+			}
+		}
+		if (
+			!user ||
+			user.email !== email ||
+			user.role.slug !== 'global:member' ||
+			user.disabled ||
+			user.mfaEnabled
+		) {
+			throw new ForbiddenError('Employee automation account is not available');
+		}
+		// Keep native signature, expiry, browser binding, MFA and quota checks.
+		this.auth.issueCookie(res, user, false, req.browserId);
+		return { ready: true };
+	}
+}
