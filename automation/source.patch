+import { Config, Env } from '../decorators';
+
+@Config
+export class SalesdeskConfig {
+	@Env('SALESDESK_BRIDGE_ENABLED')
+	enabled: boolean = false;
+
+	@Env('SALESDESK_CRM_INTERNAL_ORIGIN')
