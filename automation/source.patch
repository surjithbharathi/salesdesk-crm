+import { OutboundHttp } from '@n8n/backend-network';
+import { GlobalConfig } from '@n8n/config';
+import { mock } from 'vitest-mock-extended';
+import { SalesdeskAccessService } from '../salesdesk-access.service';
+
+describe('SalesdeskAccessService', () => {
+	const config = mock<GlobalConfig>({
+		salesdesk: { enabled: true, crmOrigin: 'http://127.0.0.1:3100', bridgeSecret: 'x'.repeat(64) },
+	});
+	const outbound = mock<OutboundHttp>();
+	const http = mock<ReturnType<OutboundHttp['requests']>>();
+	const service = new SalesdeskAccessService(config, outbound);
+	beforeEach(() => {
+		vi.resetAllMocks();
+		config.salesdesk.enabled = true;
+		config.salesdesk.crmOrigin = 'http://127.0.0.1:3100';
+		config.salesdesk.bridgeSecret = 'x'.repeat(64);
+		outbound.requests.mockReturnValue(http);
+	});
+	it('accepts only an affirmative CRM grant', async () => {
+		http.request.mockResolvedValue({ allowed: true });
+		await expect(service.assertAllowed('member')).resolves.toBeUndefined();
+		expect(http.request).toHaveBeenCalledWith(
+			expect.objectContaining({
+				url: 'http://127.0.0.1:3100/api/automation/authorize',
+				body: { engineUserId: 'member' },
+				headers: { authorization: `Bearer ${'x'.repeat(64)}` },
+			}),
+		);
+		http.request.mockResolvedValue({ allowed: false });
+		await expect(service.assertAllowed('member')).rejects.toThrow('CRM Automation access');
+	});
+	it('fails closed when CRM is unavailable or the operator configuration is invalid', async () => {
+		http.request.mockRejectedValue(new Error('network error'));
+		await expect(service.assertAllowed('member')).rejects.toThrow('CRM Automation access');
+		config.salesdesk.crmOrigin = 'https://example.com';
+		await expect(service.consume('ticket')).rejects.toThrow('CRM handoff was not accepted');
+		config.salesdesk.bridgeSecret = '';
+		await expect(service.assertAllowed('member')).rejects.toThrow('not configured');
+	});
+	it('does not change the upstream standalone mode', async () => {
+		config.salesdesk.enabled = false;
+		await service.assertAllowed('member');
+		expect(http.request).not.toHaveBeenCalled();
+	});
+});
diff --git a/packages/cli/src/services/salesdesk-access.service.ts b/packages/cli/src/services/salesdesk-access.service.ts
new file mode 100644
index 00000000..50f169c8
--- /dev/null
+++ b/packages/cli/src/services/salesdesk-access.service.ts
@@ -0,0 +1,71 @@
+// Modified for the internal Salesdesk integration. Upstream license terms apply.
+import { OutboundHttp } from '@n8n/backend-network';
+import { GlobalConfig } from '@n8n/config';
+import { Service } from '@n8n/di';
+import { ForbiddenError } from '@n8n/errors';
+import { isRecord } from '@n8n/utils/is-record';
+
+@Service()
+export class SalesdeskAccessService {
+	constructor(
+		private readonly config: GlobalConfig,
+		private readonly outbound: OutboundHttp,
+	) {}
+
+	private origin() {
+		const origin = new URL(this.config.salesdesk.crmOrigin);
+		if (
+			origin.protocol !== 'http:' ||
+			!['127.0.0.1', 'localhost', 'salesdesk'].includes(origin.hostname) ||
+			origin.username ||
+			origin.password ||
+			origin.pathname !== '/' ||
+			origin.search ||
+			origin.hash
+		) {
+			throw new ForbiddenError('CRM internal origin is not valid');
+		}
+		return origin.origin;
+	}
+
+	async consume(ticket: string): Promise<unknown> {
+		try {
+			// The operator fixes this private address. Workflow inputs cannot change it.
+			return await this.outbound.requests({ useDefaultSsrfPolicy: 'unsafe' }).request({
+				method: 'POST',
+				url: `${this.origin()}/api/automation/consume`,
+				body: { ticket },
+				json: true,
+				timeout: 5000,
+				disableFollowRedirect: true,
+				maxResponseBodyBytes: 8192,
+			});
+		} catch {
+			throw new ForbiddenError('CRM handoff was not accepted');
+		}
+	}
+
+	async assertAllowed(engineUserId: string) {
+		if (!this.config.salesdesk.enabled) return;
+		if (this.config.salesdesk.bridgeSecret.length < 43)
+			throw new ForbiddenError('CRM authorization is not configured');
+		let result: unknown;
+		try {
+			// This is a fixed, private control-plane call, not a user-selected node URL.
+			result = await this.outbound.requests({ useDefaultSsrfPolicy: 'unsafe' }).request({
+				method: 'POST',
+				url: `${this.origin()}/api/automation/authorize`,
+				headers: { authorization: `Bearer ${this.config.salesdesk.bridgeSecret}` },
+				body: { engineUserId },
+				json: true,
+				timeout: 5000,
+				disableFollowRedirect: true,
+				maxResponseBodyBytes: 8192,
+			});
+		} catch {
+			throw new ForbiddenError('CRM Automation access is not available');
+		}
+		if (!isRecord(result) || result.allowed !== true)
+			throw new ForbiddenError('CRM Automation access is not available');
+	}
+}
